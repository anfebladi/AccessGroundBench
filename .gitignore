# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# macOS filesystem metadata
.DS_Store
._*

# Generated capture/extraction outputs
outputs/*
!outputs/.gitkeep



# Generated JSON from committed sample inputs
sample_input/capture_*.json

# Android/local tooling logs
*.log
*.err
*.pid
adb*.txt

# Result-CSV canonicalization safety copies and single-writer locks
# (see vlm_eval.results.canonicalize_rows / acquire_lock), plus the
# pre-rescore backups rescore_coords.py writes as dataset/*.csv.bak --
# already covered by the *.bak glob.
dataset/*.bak
dataset/*.lock
