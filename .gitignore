# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
src/webui/frontend/node_modules/
src/webui/frontend/dist/
src/webui/frontend/test-results/
src/webui/frontend/playwright-report/
src/webui/frontend/*.tsbuildinfo
*.egg-info/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# macOS filesystem metadata
.DS_Store
._*

# Scratch output from the standalone `agb capture` command. Everything else
# under experiment/outputs/ is per-dataset results and is committed.
experiment/outputs/captures/

# Superseded collection runs. Kept locally as a record, never published: they
# predate several scoring fixes (so they must not be cited) and their captures
# contain personal data that the current dataset has had removed. Each archive
# holds its own outputs/ too, so this one rule covers their tables as well.
experiment/archive/

# Copies kept aside before a command replaces a result file (src/backups.py).
# Local safety net, not a record: committing them would put stale evaluation
# rows in the repo looking like results. Safe to delete at any time.
.backups/


# Generated JSON from committed sample inputs
sample_input/capture_*.json

# Android/local tooling logs
*.log
*.err
*.pid
adb*.txt

# Evaluation-result canonicalization safety copies and single-writer locks.
# Matched by suffix rather than directory: results moved from dataset/ to
# outputs/<dataset>/evaluations/, which left the old dataset/*.lock rule
# matching nothing and a killed run's lock file showing up as a commit
# candidate. Scoped to .csv.* so it cannot shadow the tracked uv.lock.
*.csv.bak
*.csv.lock

# Stale local Ferret-UI input fixture at the repository root only.
/eval.json

# Analysis output from the web UI (derived, regenerable; never the dataset itself)
ui_experiments/

# Local scratch notes for in-flight work. Not a project record -- anything worth
# keeping belongs in docs/.
NOTES.local.md
*.local.md

# Agent context and configuration. Useful locally, but they document how the
# work was done rather than what the benchmark is, and reference internal
# history that means nothing to an outside reader.
CLAUDE.md
AGENTS.md
.codex/

# Ferret-UI model code fetched from Hugging Face by ferret_ui/download_scripts.py.
# Third-party (Apple Ferret-UI / Meta Llama 3 / LLaVA lineage) and NOT covered by
# this repository's licence, so it is downloaded from upstream rather than
# redistributed here. See docs/ferret-ui.md.
ferret_ui/builder.py
ferret_ui/clip_encoder.py
ferret_ui/constants.py
ferret_ui/conversation.py
ferret_ui/inference.py
ferret_ui/mm_utils.py
ferret_ui/model_UI.py
ferret_ui/eval.json
