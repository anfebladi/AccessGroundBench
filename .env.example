

VLM_MODEL=openai/gpt-4o-mini, gemini/gemini-2.5-pro, local/ferret-ui-llama8b
VLM_PACE_SECONDS=0
VLM_MAX_RETRIES=3
VLM_REQUEST_TIMEOUT_SECONDS=120

# Sampling temperature. Defaults to 0 so a run is reproducible; set to an empty
# string to omit the parameter entirely. Models that reject an explicit
# temperature are detected and retried without it.
VLM_TEMPERATURE=0

# Repeat each query this many times and score by majority vote. Repeats do not
# add statistical power -- they measure how stable a single draw is, which is
# what lets a marginal result be defended as something other than sampling
# noise. Leave at 1 unless you need that evidence.
VLM_TRIALS=1

# Optional: restrict repeats to specific models, so budget is spent only where
# a claim depends on it. Empty means VLM_TRIALS applies to every model.
VLM_TRIALS_MODELS=


USE_A11Y_TREE=false
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 9Router / Codex-quota OpenAI-compatible gateway (optional)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your-9router-api-key-here

# Any other OpenAI-compatible gateway (optional)
OPENAI_COMPATIBLE_BASE_URL=https://provider.example.com/v1
OPENAI_COMPATIBLE_API_KEY=your-compatible-provider-key-here
