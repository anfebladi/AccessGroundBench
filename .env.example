

VLM_MODEL=openai/gpt-4o-mini, gemini/gemini-2.5-pro, local/ferret-ui-llama8b
VLM_PACE_SECONDS=0
VLM_MAX_RETRIES=3
VLM_REQUEST_TIMEOUT_SECONDS=120

# Sampling temperature. Defaults to 0 so a run is reproducible; set to an empty
# string to omit the parameter entirely. Models that reject an explicit
# temperature are detected and retried without it.
VLM_TEMPERATURE=0

# Reply token budget. Empty sends no budget at all, which is what every model
# in the current roster ran under -- set it and a re-run is no longer comparable
# with its own committed CSV. Worth setting for a model that thinks: reasoning
# and the answer share this budget, and with nothing specified the ceiling is
# whatever the provider or LiteLLM picks (LiteLLM injects 4096 for Anthropic,
# which requires the field). A reply that hits the budget is recorded as
# api_error, never scored as a grounding miss.
VLM_MAX_TOKENS=

# Extended thinking, for models that support it (Anthropic only). Empty leaves
# each provider's own default, which is NOT uniform: Claude Opus 5 and Sonnet 5
# think by default, Haiku 4.5 does not. Set this when a run needs every model on
# the same footing -- whether a model reasons before answering is a difference
# in test-time compute, not just in cost.
#   adaptive - the model decides how much to think
#   disabled - one forward pass (pair with a small VLM_MAX_TOKENS)
VLM_THINKING=

# Constrain the reply to a coordinate array via a JSON schema (Anthropic only).
# Empty leaves the model free to answer however it likes. Worth enabling for a
# model that ignores the prompt's format instruction -- Haiku 4.5 answers with
# ~650 characters of prose per query where Sonnet 4.6, same prompt, answers in
# 16. Note the trade-off: a model with no thinking mode uses that prose to
# refine its estimate, so forcing compliance can cost accuracy as well as
# tokens. It also changes the request shape, so a model run with it is not
# strictly comparable to one run without.
VLM_STRUCTURED_COORDS=

# Repeat each query this many times and score by majority vote. Repeats do not
# add statistical power -- they measure how stable a single draw is, which is
# what lets a marginal result be defended as something other than sampling
# noise. Leave at 1 unless you need that evidence.
VLM_TRIALS=1

# Optional: restrict repeats to specific models, so budget is spent only where
# a claim depends on it. Empty means VLM_TRIALS applies to every model.
VLM_TRIALS_MODELS=


USE_A11Y_TREE=false

# Coordinate convention the model answers in. Default: pixel
#   pixel    - absolute image pixels (GPT, Ferret-UI)
#   norm1000 - a 0-1000 grid independent of image size (Qwen-VL, Gemini, GLM-V)
# Scoring a norm1000 model as pixel compresses every prediction into the
# top-left corner and reports 0% accuracy. Confirm a model's convention with:
#   agb rescore --csv <results.csv> --check
COORD_SPACE=pixel
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 9Router / Codex-quota OpenAI-compatible gateway (optional)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your-9router-api-key-here

# Any other OpenAI-compatible gateway (optional)
OPENAI_COMPATIBLE_BASE_URL=https://provider.example.com/v1
OPENAI_COMPATIBLE_API_KEY=your-compatible-provider-key-here
