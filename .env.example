# Provider API keys used by vlm_evaluator.py through LiteLLM.
# Set the key for whichever direct provider model you run.

#if api is a place holder pls add your and -here to it 
# so it gets safely skip

VLM_MODEL=openai/gpt-4o-mini
VLM_PACE_SECONDS=0
VLM_MAX_RETRIES=3

# Set to true to inject the accessibility tree into the VLM prompt
# alongside the screenshot (mitigation condition). Default: false
USE_A11Y_TREE=false
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
